<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle or title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonical or (page.url | absoluteUrl) }}">

  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:locale" content="en_CA">
  {% if ogImage %}<meta property="og:image" content="{{ ogImage | absoluteUrl }}">{% endif %}

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ description }}">

  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} — Field Notes" href="{{ '/feed.xml' | absoluteUrl }}">
  <link rel="stylesheet" href="/css/main.css">

  {% if site.url %}<link rel="icon" href="/assets/logo.svg" type="image/svg+xml">{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}"
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  {% if draft %}
  <div class="draft-banner" role="alert">Draft — not published</div>
  {% endif %}

  <header class="site-header">
    <nav aria-label="Primary">
      <a href="/" class="site-name" aria-label="{{ site.name }} home">CODACON</a>
      <ul class="nav-links">
        {%- for item in navigation.main %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </header>

  <main id="main-content" class="page-content {% if narrowLayout %}page-content--narrow{% endif %}">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p class="footer-tagline">{{ site.tagline }}</p>
    <div class="footer-inner">
      <p>&copy; {{ year }} {{ site.legalName }} All rights reserved.</p>
      <ul class="footer-links">
        {%- for item in navigation.footer %}
        <li><a href="{{ item.url }}"{% if item.external %} rel="noopener" target="_blank"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <p><small>Blog content licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Code licensed under <a href="https://github.com/CodaConAI/codaconai.github.io/blob/main/LICENSE">MIT</a>.</small></p>
  </footer>
</body>
</html>
