---
layout: base.njk
narrowLayout: true
---
{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "datePublished": "{{ date | dateISO }}",
  {% if updated %}"dateModified": "{{ updated | dateISO }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "url": "{{ site.url }}/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.legalName }}",
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ page.url | absoluteUrl }}"
  }
}
</script>
{% endblock %}

<article>
  <header class="post-header">
    <div class="post-meta">
      <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
      <span>{{ content | readingTime }} read</span>
    </div>
    <h1>{{ title }}</h1>
    {% if tags %}
    <ul class="tags">
      {% for tag in tags %}{% if tag != "post" %}<li>{{ tag }}</li>{% endif %}{% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <p class="license">Articles available under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> unless otherwise noted — attribution with a link to <a href="{{ page.url | absoluteUrl }}">the original</a> is required.</p>

    <div class="cta">
      <h2>Stay current</h2>
      <p>Subscribe to the <a href="/feed.xml">RSS feed</a> for new field notes on AI security, cloud governance, and secure delivery.</p>
    </div>

    <div class="cta">
      <h2>Bring us a workflow</h2>
      <p><a href="mailto:{{ site.contactEmail }}">Get in touch</a> to discuss a consequential workflow, security posture, or AI strategy.</p>
    </div>
  </footer>
</article>
