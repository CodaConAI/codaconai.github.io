---
layout: base.njk
---
{%- set t = i18n[lang] -%}
{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "inLanguage": "{{ t.htmlLang }}",
  "datePublished": "{{ date | dateISO }}",
  {% if updated %}"dateModified": "{{ updated | dateISO }}",{% endif %}
  "author": {
    "@type": "Organization",
    "name": "CODACON Inc.",
    "url": "https://codacon.ai"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CODACON Inc.",
    "url": "https://codacon.ai"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ page.url | absoluteUrl }}"
  }
}
</script>
{% endblock %}

<article>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time datetime="{{ date | dateISO }}">{{ date | dateDisplay(lang) }}</time>
    {% if tags %}
    <ul class="tags">
      {% for tag in tags %}{% if tag != "post" and tag != "post-fr" %}<li>{{ t.tags[tag] or tag }}</li>{% endif %}{% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <hr>
    <p class="license">{{ t.post.license | safe }} <a href="{{ page.url | absoluteUrl }}">{{ t.post.original }}</a>.</p>

    <div class="cta">
      <h2>{{ t.post.cta1Title }}</h2>
      <p>{{ t.post.cta1Body | safe }}</p>
    </div>

    <div class="cta">
      <h2>{{ t.post.cta2Title }}</h2>
      <p>{{ t.post.cta2Body | safe }}</p>
    </div>
  </footer>
</article>
